# Environment variables for DinnerHome Backend
PORT=8000
HOST=0.0.0.0
ENV=production

# Database URL: In Railway, this is provided automatically when you add a PostgreSQL plugin.
# For local dev without Postgres, leaving this empty will default to SQLite: sqlite:///./dinnerhome.db
DATABASE_URL=sqlite:///./dinnerhome.db

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# CORS settings: comma-separated list of allowed origins (or * for all)
CORS_ORIGINS=*

# Initial Admin Credentials (created on first run if not exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador
